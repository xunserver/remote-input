{
  "name": "@remote-copy/protocol",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./definitions": {
      "types": "./dist/definitions/index.d.ts",
      "default": "./dist/definitions/index.js"
    },
    "./implementations": {
      "types": "./dist/implementations/index.d.ts",
      "default": "./dist/implementations/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "socket.io": "^4.8.1",
    "typescript": "^7.0.2"
  }
}
