{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_PROTOCOL_DEBUG"]
    },
    "check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "HOST",
        "PORT",
        "INPUT_MODE",
        "PROTOCOL_DEBUG",
        "VITE_PROTOCOL_DEBUG"
      ]
    },
    "start": {
      "dependsOn": ["build", "@remote-copy/client#build"],
      "cache": false,
      "persistent": true,
      "env": [
        "HOST",
        "PORT",
        "INPUT_MODE",
        "PROTOCOL_DEBUG",
        "VITE_PROTOCOL_DEBUG"
      ]
    }
  }
}
