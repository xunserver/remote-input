{
  "name": "@remote-input/client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.config.ts && vite build --config vite.config.ts --mode bookmarklet-lib",
    "build:pages": "vite build --config vite.config.ts --mode pages && vite build --config vite.config.ts --mode pages-lib",
    "check": "vue-tsc --noEmit -p tsconfig.json",
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.mjs tests/*.test.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.25.0",
    "@remote-input/protocol": "workspace:*",
    "@remote-input/sdk": "workspace:*",
    "@remote-input/web-agent-sdk": "workspace:*",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vue-tsc": "^3.3.7"
  }
}
