{
  "name": "@remote-input/pc-agent",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-public.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-timeout=10000 tests/*.test.mjs",
    "start": "node dist/main.js",
    "dev": "node dist/main.js",
    "install:user": "node scripts/user-service.mjs install",
    "uninstall:user": "node scripts/user-service.mjs uninstall"
  },
  "dependencies": {
    "@remote-input/web-agent-sdk": "workspace:*",
    "@remote-input/device-protocol": "workspace:*",
    "@remote-input/protocol": "workspace:*",
    "@remote-input/sdk": "workspace:*",
    "clipboardy": "^5.3.1",
    "node-hid": "^3.2.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@remote-input/client": "workspace:*",
    "@remote-input/receiver": "workspace:*",
    "@remote-input/web-agent": "workspace:*",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  }
}
