{
  "name": "remote-input",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "scripts": {
    "build": "turbo run build",
    "package:pc-agent": "turbo run package:portable --filter=@remote-input/pc-agent",
    "build:pages": "turbo run build:pages --filter=@remote-input/client",
    "check": "turbo run check",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --filter=@remote-input/e2e",
    "test:e2e:ui": "turbo run test:e2e:ui --filter=@remote-input/e2e",
    "dev": "turbo run dev",
    "dev:client": "turbo run dev --filter=@remote-input/client",
    "dev:pc-agent": "turbo run dev --filter=@remote-input/pc-agent",
    "start": "turbo run start --filter=@remote-input/pc-agent",
    "install:user": "turbo run install:user --filter=@remote-input/pc-agent",
    "uninstall:user": "turbo run uninstall:user --filter=@remote-input/pc-agent"
  },
  "packageManager": "pnpm@10.0.0",
  "devDependencies": {
    "turbo": "^2.6.3",
    "typescript": "^7.0.2"
  }
}
