{
  "name": "remote-copy",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "dev:client": "turbo run dev --filter=@remote-copy/client",
    "dev:server": "turbo run dev --filter=@remote-copy/server",
    "start": "turbo run start --filter=@remote-copy/server",
    "build:client": "turbo run build --filter=@remote-copy/client",
    "build:server": "turbo run build --filter=@remote-copy/server",
    "build:protocol": "turbo run build --filter=@remote-copy/protocol",
    "build:sdk": "turbo run build --filter=@remote-copy/sdk",
    "check:client": "turbo run check --filter=@remote-copy/client",
    "check:server": "turbo run check --filter=@remote-copy/server",
    "check:protocol": "turbo run check --filter=@remote-copy/protocol",
    "check:sdk": "turbo run check --filter=@remote-copy/sdk",
    "test:protocol": "turbo run test --filter=@remote-copy/protocol",
    "test:sdk": "turbo run test --filter=@remote-copy/sdk",
    "test:server": "turbo run test --filter=@remote-copy/server"
  },
  "packageManager": "pnpm@10.0.0",
  "devDependencies": {
    "turbo": "^2.6.3",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["node-hid"]
  }
}
